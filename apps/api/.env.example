# DueGuard Backend Environment Variables (apps/api/.dev.vars)
# Copy this file to apps/api/.dev.vars for local development.
# In production, set secrets via: npx wrangler secret put <NAME>
# NEVER commit apps/api/.dev.vars or real credentials to git!

JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"
APP_BASE_URL="http://localhost:5173"

# Optional Email Alerts via Resend (https://resend.com)
RESEND_API_KEY="re_placeholder_secret_key"
EMAIL_FROM="DueGuard Alerts <alerts@yourdomain.com>"

# Optional Telegram Bot Alerts via @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_BOT_USERNAME="your_dueguard_bot"
TELEGRAM_WEBHOOK_SECRET="optional-random-webhook-secret"
