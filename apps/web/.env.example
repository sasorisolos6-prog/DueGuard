# DueGuard Frontend Environment Variables (apps/web/.env)
# Copy this file to apps/web/.env when pointing to a deployed backend.

# In local development, leave empty so Vite automatically proxies /api/* to http://127.0.0.1:8787.
# In production, set to your live Cloudflare Worker API URL:
VITE_API_URL="https://dueguard-api.yoursubdomain.workers.dev"
