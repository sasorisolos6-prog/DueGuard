# ==============================================================================
# DueGuard Environment Variables Template
# NEVER COMMIT REAL SECRETS TO GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (apps/web/.env)
# ------------------------------------------------------------------------------
# In local dev, leave blank — Vite proxies /api/* to http://127.0.0.1:8787 automatically.
# In production, set to your deployed Cloudflare Worker API URL:
VITE_API_URL="https://dueguard-api.yoursubdomain.workers.dev"

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION (apps/api/.dev.vars for local, wrangler secrets for prod)
# ------------------------------------------------------------------------------
# Minimum 16 characters required (use a strong 32+ character random string in production)
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"

# Frontend origin allowed for CORS and email/telegram alert links
APP_BASE_URL="http://localhost:5173"

# Optional Email Alerts via Resend (https://resend.com — 3,000 free emails/month)
# If blank, email alerts safely log previews in local dev console.
RESEND_API_KEY="re_placeholder_secret_key"
EMAIL_FROM="DueGuard Alerts <alerts@yourdomain.com>"

# Optional Telegram Bot Alerts via @BotFather (100% free)
# If blank, telegram alerts safely log previews in local dev console.
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_BOT_USERNAME="your_dueguard_bot"
TELEGRAM_WEBHOOK_SECRET="optional-random-webhook-secret"
